generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlserver"
}

model Directorate {
  id          String           @id @default(uuid()) @db.UniqueIdentifier
  code        String           @unique
  name        String           @unique
  description String?
  status      String           @default("ACTIVE")
  sortOrder   Int              @default(0)
  departments Department[]
  requests    VehicleRequest[]
  users       User[]
  fuelBudgets FuelBudget[]
  createdAt   DateTime         @default(now()) @db.DateTime2
  updatedAt   DateTime         @updatedAt @db.DateTime2

  @@index([status, sortOrder, name])
  @@map("directorates")
}

model Department {
  id            String           @id @default(uuid()) @db.UniqueIdentifier
  directorateId String           @db.UniqueIdentifier
  code          String           @unique
  name          String
  description   String?
  status        String           @default("ACTIVE")
  sortOrder     Int              @default(0)
  directorate   Directorate      @relation(fields: [directorateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  units         Unit[]
  requests      VehicleRequest[]
  users         User[]
  fuelBudgets   FuelBudget[]
  createdAt     DateTime         @default(now()) @db.DateTime2
  updatedAt     DateTime         @updatedAt @db.DateTime2

  @@unique([directorateId, name])
  @@index([directorateId, status, sortOrder, name])
  @@map("departments")
}

model Unit {
  id           String           @id @default(uuid()) @db.UniqueIdentifier
  departmentId String           @db.UniqueIdentifier
  code         String           @unique
  name         String
  description  String?
  status       String           @default("ACTIVE")
  sortOrder    Int              @default(0)
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requests     VehicleRequest[]
  users        User[]
  createdAt    DateTime         @default(now()) @db.DateTime2
  updatedAt    DateTime         @updatedAt @db.DateTime2

  @@unique([departmentId, name])
  @@index([departmentId, status, sortOrder, name])
  @@map("units")
}

model Location {
  id          String           @id @default(uuid()) @db.UniqueIdentifier
  code        String           @unique
  name        String           @unique
  address     String?
  state       String?
  latitude    Float?
  longitude   Float?
  description String?
  status      String           @default("ACTIVE")
  sortOrder   Int              @default(0)
  requests    VehicleRequest[]
  users       User[]
  vehicles    Vehicle[]
  drivers     Driver[]
  fuelCards   FuelCard[]
  fuelBudgets FuelBudget[]
  createdAt   DateTime         @default(now()) @db.DateTime2
  updatedAt   DateTime         @updatedAt @db.DateTime2

  @@index([status, sortOrder, name])
  @@map("locations")
}

model VehicleType {
  id                String           @id @default(uuid()) @db.UniqueIdentifier
  code              String           @unique
  name              String           @unique
  description       String?
  passengerCapacity Int?
  mapIcon           String?          @db.NVarChar(300)
  mapIconMimeType   String?          @db.NVarChar(100)
  mapIconData       Bytes?
  status            String           @default("ACTIVE")
  sortOrder         Int              @default(0)
  speedLimit        Float?
  requests          VehicleRequest[]
  vehicles          Vehicle[]
  speedViolations   SpeedViolation[]
  createdAt         DateTime         @default(now()) @db.DateTime2
  updatedAt         DateTime         @updatedAt @db.DateTime2

  @@index([status, sortOrder, name])
  @@map("vehicle_types")
}

model Role {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  code         String   @unique
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false)
  status       String   @default("ACTIVE")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @db.DateTime2
  updatedAt    DateTime @updatedAt @db.DateTime2
  users        User[]

  @@index([status, sortOrder, name])
  @@map("roles")
}

model User {
  id                          String                @id @default(uuid()) @db.UniqueIdentifier
  email                       String                @unique
  passwordHash                String
  staffName                   String
  employeeId                  String                @unique
  phone                       String?
  passportMimeType            String?
  passportData                Bytes?
  status                      String                @default("ACTIVE")
  roleId                      String                @db.UniqueIdentifier
  locationId                  String?               @db.UniqueIdentifier
  directorateId               String?               @db.UniqueIdentifier
  departmentId                String?               @db.UniqueIdentifier
  unitId                      String?               @db.UniqueIdentifier
  role                        Role                  @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location                    Location?             @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  directorate                 Directorate?          @relation(fields: [directorateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department                  Department?           @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit                        Unit?                 @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions                    Session[]
  requests                    VehicleRequest[]
  assignedAllocations         VehicleAllocation[]   @relation("AllocationAssigner")
  maintenanceReports          MaintenanceRequest[]  @relation("MaintenanceReporter")
  maintenanceReviews          MaintenanceRequest[]  @relation("MaintenanceReviewer")
  fuelEntriesCreated          FuelEntry[]           @relation("FuelEntryCreator")
  fuelApprovals               FuelApproval[]        @relation("FuelApprovalActor")
  fuelAuditLogs               FuelAuditLog[]        @relation("FuelAuditActor")
  speedSettingsUpdated        FleetSpeedSetting[]   @relation("SpeedSettingUpdater")
  speedViolationsAcknowledged SpeedViolation[]      @relation("SpeedViolationAcknowledger")
  speedViolationAudits        SpeedViolationAudit[] @relation("SpeedViolationAuditActor")
  driverRatings               DriverRating[]
  createdAt                   DateTime              @default(now()) @db.DateTime2
  updatedAt                   DateTime              @updatedAt @db.DateTime2

  @@index([status, staffName])
  @@index([roleId])
  @@map("users")
}

model Vehicle {
  id                         String                  @id @default(uuid()) @db.UniqueIdentifier
  registrationNumber         String                  @unique
  serialNumber               String?
  locationUser               String?
  privateRegistrationNumber  String?
  officialRegistrationNumber String?
  manufacturer               String
  model                      String
  year                       Int?
  purchaseCost               String?
  bookedValue                String?
  estimatedCost              String?
  reservedPresentValue       String?
  age                        String?
  serviceability             String?
  legacyAgency               String?
  chassisNumber              String?
  engineNumber               String?
  remark                     String?
  faultDescription           String?
  color                      String?
  status                     String                  @default("AVAILABLE")
  locationId                 String?                 @db.UniqueIdentifier
  vehicleTypeId              String?                 @db.UniqueIdentifier
  customSpeedLimit           Float?
  previousOdometer           Decimal?                @db.Decimal(18, 2)
  currentOdometer            Decimal?                @db.Decimal(18, 2)
  imageMimeType              String?
  imageData                  Bytes?
  location                   Location?               @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleType                VehicleType?            @relation(fields: [vehicleTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt                  DateTime                @default(now()) @db.DateTime2
  updatedAt                  DateTime                @updatedAt @db.DateTime2
  allocations                VehicleAllocation[]
  currentLocations           DriverCurrentLocation[]
  locationHistory            DriverLocationHistory[]
  trips                      Trip[]
  maintenanceRequests        MaintenanceRequest[]
  fuelEntries                FuelEntry[]
  fuelCards                  FuelCard[]
  fuelBaseline               VehicleFuelBaseline?
  speedReadings              SpeedReading[]
  speedViolations            SpeedViolation[]

  @@index([status, registrationNumber])
  @@map("vehicles")
}

model MaintenanceRequest {
  id               String    @id @default(uuid()) @db.UniqueIdentifier
  vehicleId        String    @db.UniqueIdentifier
  reportedById     String    @db.UniqueIdentifier
  issueType        String
  issueDescription String    @db.NVarChar(2000)
  issueOccurredAt  DateTime  @db.DateTime2
  evidenceMimeType String?
  evidenceData     Bytes?
  status           String    @default("PENDING_REVIEW")
  serviceability   String?   @db.NVarChar(30)
  adminRemark      String?   @db.NVarChar(2000)
  reviewedById     String?   @db.UniqueIdentifier
  reviewedAt       DateTime? @db.DateTime2
  driverFeedback   String?   @db.NVarChar(30)
  driverFeedbackRemark String? @db.NVarChar(1000)
  driverFeedbackAt DateTime? @db.DateTime2
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportedBy       User      @relation("MaintenanceReporter", fields: [reportedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy       User?     @relation("MaintenanceReviewer", fields: [reviewedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt        DateTime  @default(now()) @db.DateTime2
  updatedAt        DateTime  @updatedAt @db.DateTime2

  @@index([status, createdAt])
  @@index([vehicleId, createdAt])
  @@index([reportedById, createdAt])
  @@map("maintenance_requests")
}

model Driver {
  id               String                  @id @default(uuid()) @db.UniqueIdentifier
  serialNumber     String?
  staffName        String
  employeeId       String                  @unique
  locationText     String?
  zone             String?
  category         String?
  phone            String
  email            String?
  licenceNumber    String?
  licenceClass     String?
  licenceExpiry    DateTime?               @db.Date
  status           String                  @default("AVAILABLE")
  locationId       String?                 @db.UniqueIdentifier
  passportMimeType String?
  passportData     Bytes?
  location         Location?               @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt        DateTime                @default(now()) @db.DateTime2
  updatedAt        DateTime                @updatedAt @db.DateTime2
  allocations      VehicleAllocation[]
  currentLocation  DriverCurrentLocation?
  locationHistory  DriverLocationHistory[]
  trips            Trip[]
  fuelEntries      FuelEntry[]
  fuelCards        FuelCard[]
  speedReadings    SpeedReading[]
  speedViolations  SpeedViolation[]
  ratings          DriverRating[]

  @@index([status, staffName])
  @@index([licenceNumber])
  @@map("drivers")
}

model VehicleAllocation {
  id               String                  @id @default(uuid()) @db.UniqueIdentifier
  requestId        String?                 @db.UniqueIdentifier
  vehicleId        String                  @db.UniqueIdentifier
  driverId         String                  @db.UniqueIdentifier
  assignedById     String?                 @db.UniqueIdentifier
  purpose          String
  destination      String?
  startAt          DateTime                @db.DateTime2
  expectedEndAt    DateTime                @db.DateTime2
  actualStartAt    DateTime?               @db.DateTime2
  actualEndAt      DateTime?               @db.DateTime2
  status           String                  @default("ASSIGNED")
  notes            String?
  rejectionReason  String?
  emergencyAt      DateTime?               @db.DateTime2
  request          VehicleRequest?         @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicle          Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver           Driver                  @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedBy       User?                   @relation("AllocationAssigner", fields: [assignedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trip             Trip?
  createdAt        DateTime                @default(now()) @db.DateTime2
  updatedAt        DateTime                @updatedAt @db.DateTime2
  currentLocations DriverCurrentLocation[]
  locationHistory  DriverLocationHistory[]
  fuelEntries      FuelEntry[]

  @@index([status, startAt])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@index([requestId, status])
  @@index([assignedById])
  @@map("vehicle_allocations")
}

model DriverCurrentLocation {
  id             String             @id @default(uuid()) @db.UniqueIdentifier
  driverId       String             @unique @db.UniqueIdentifier
  vehicleId      String?            @db.UniqueIdentifier
  allocationId   String?            @db.UniqueIdentifier
  tripId         String?            @db.UniqueIdentifier
  latitude       Float
  longitude      Float
  accuracy       Float?
  speed          Float?
  heading        Float?
  altitude       Float?
  recordedAt     DateTime           @db.DateTime2
  receivedAt     DateTime           @default(now()) @db.DateTime2
  trackingSource String             @default("PHONE_GPS")
  isSimulated    Boolean            @default(false)
  driver         Driver             @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicle        Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  allocation     VehicleAllocation? @relation(fields: [allocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trip           Trip?              @relation(fields: [tripId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedAt      DateTime           @updatedAt @db.DateTime2

  @@index([recordedAt])
  @@index([vehicleId, recordedAt])
  @@index([allocationId])
  @@index([tripId])
  @@map("driver_current_locations")
}

model DriverLocationHistory {
  id            String             @id @default(uuid()) @db.UniqueIdentifier
  driverId      String             @db.UniqueIdentifier
  vehicleId     String?            @db.UniqueIdentifier
  allocationId  String?            @db.UniqueIdentifier
  tripId        String?            @db.UniqueIdentifier
  clientEventId String             @unique
  latitude      Float
  longitude     Float
  accuracy      Float?
  speed         Float?
  heading       Float?
  altitude      Float?
  recordedAt    DateTime           @db.DateTime2
  receivedAt    DateTime           @default(now()) @db.DateTime2
  isSimulated   Boolean            @default(false)
  driver        Driver             @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicle       Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  allocation    VehicleAllocation? @relation(fields: [allocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trip          Trip?              @relation(fields: [tripId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime           @default(now()) @db.DateTime2

  @@index([driverId, recordedAt])
  @@index([allocationId, recordedAt])
  @@index([vehicleId, recordedAt])
  @@index([tripId, recordedAt])
  @@map("driver_location_history")
}

model Session {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  tokenHash String   @unique
  userId    String   @db.UniqueIdentifier
  expiresAt DateTime @db.DateTime2
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.DateTime2

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VehicleRequest {
  id                   String              @id @default(uuid()) @db.UniqueIdentifier
  requestNumber        String              @unique
  staffName            String
  employeeId           String
  locationId           String?             @db.UniqueIdentifier
  directorateId        String              @db.UniqueIdentifier
  departmentId         String?             @db.UniqueIdentifier
  unitId               String?             @db.UniqueIdentifier
  vehicleTypeId        String              @db.UniqueIdentifier
  requesterId          String?             @db.UniqueIdentifier
  location             String
  directorate          String
  department           String
  unit                 String
  purposeOfTrip        String
  tripCategory         String?             @db.NVarChar(30)
  legacyPurposeOfTrip  String?             @db.NVarChar(2000)
  vehicleTypeName      String
  destination          String
  customPickupLocation String?             @db.NVarChar(300)
  customDestination    String?             @db.NVarChar(300)
  customDepartment     String?             @db.NVarChar(200)
  customUnit           String?             @db.NVarChar(200)
  departureDate        DateTime            @db.DateTime2
  expectedReturnDate   DateTime            @db.DateTime2
  numberOfPassengers   Int
  priority             String
  remarks              String?
  attachmentFileName   String?
  attachmentMimeType   String?
  attachmentSizeBytes  Int?
  attachmentData       Bytes?
  status               String              @default("PENDING_APPROVAL")
  locationMaster       Location?           @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  directorateMaster    Directorate         @relation(fields: [directorateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departmentMaster     Department?         @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unitMaster           Unit?               @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleTypeMaster    VehicleType         @relation(fields: [vehicleTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requester            User?               @relation(fields: [requesterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  allocations          VehicleAllocation[]
  trips                Trip[]
  ratings              DriverRating[]
  createdAt            DateTime            @default(now()) @db.DateTime2
  updatedAt            DateTime            @updatedAt @db.DateTime2

  @@index([status, departureDate])
  @@index([employeeId, createdAt])
  @@index([locationId])
  @@index([directorateId])
  @@index([departmentId])
  @@index([unitId])
  @@index([vehicleTypeId])
  @@index([requesterId])
  @@index([tripCategory, departureDate])
  @@map("vehicle_requests")
}

model Trip {
  id                 String                  @id @default(uuid()) @db.UniqueIdentifier
  allocationId       String                  @unique @db.UniqueIdentifier
  requestId          String?                 @db.UniqueIdentifier
  vehicleId          String                  @db.UniqueIdentifier
  driverId           String                  @db.UniqueIdentifier
  startLatitude      Float?
  startLongitude     Float?
  endLatitude        Float?
  endLongitude       Float?
  startedAt          DateTime?               @db.DateTime2
  endedAt            DateTime?               @db.DateTime2
  calculatedDistance Float?
  maximumSpeed       Float?
  averageSpeed       Float?
  status             String                  @default("NOT_STARTED")
  allocation         VehicleAllocation       @relation(fields: [allocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  request            VehicleRequest?         @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicle            Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver             Driver                  @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentLocations   DriverCurrentLocation[]
  locationHistory    DriverLocationHistory[]
  fuelEntries        FuelEntry[]
  speedReadings      SpeedReading[]
  speedViolations    SpeedViolation[]
  rating             DriverRating?
  createdAt          DateTime                @default(now()) @db.DateTime2
  updatedAt          DateTime                @updatedAt @db.DateTime2

  @@index([status, startedAt])
  @@index([vehicleId, startedAt])
  @@index([driverId, startedAt])
  @@index([requestId])
  @@map("trips")
}

model DriverRating {
  id         String         @id @default(uuid()) @db.UniqueIdentifier
  tripId     String         @unique @db.UniqueIdentifier
  requestId  String         @db.UniqueIdentifier
  driverId   String         @db.UniqueIdentifier
  ratedById  String         @db.UniqueIdentifier
  stars      Int
  likedTrip  Boolean
  remark     String?        @db.NVarChar(1000)
  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  request    VehicleRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver     Driver         @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ratedBy    User           @relation(fields: [ratedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt  DateTime       @default(now()) @db.DateTime2

  @@index([driverId, createdAt])
  @@index([ratedById, createdAt])
  @@map("driver_ratings")
}

model FleetSpeedSetting {
  id                              String   @id @default(uuid()) @db.UniqueIdentifier
  defaultSpeedLimit               Float    @default(80)
  speedUnit                       String   @default("KMH")
  graceSpeed                      Float    @default(5)
  minimumViolationDurationSeconds Int      @default(10)
  recoveryDurationSeconds         Int      @default(10)
  alertCooldownMinutes            Int      @default(15)
  alertsEnabled                   Boolean  @default(true)
  lowSeverityMaxExcess            Float    @default(10)
  mediumSeverityMaxExcess         Float    @default(20)
  highSeverityMaxExcess           Float    @default(40)
  maximumAllowedSpeedLimit        Float    @default(200)
  staleAfterSeconds               Int      @default(120)
  readingRetentionDays            Int      @default(90)
  updatedById                     String?  @db.UniqueIdentifier
  updatedBy                       User?    @relation("SpeedSettingUpdater", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt                       DateTime @default(now()) @db.DateTime2
  updatedAt                       DateTime @updatedAt @db.DateTime2

  @@index([updatedAt])
  @@map("fleet_speed_settings")
}

model SpeedReading {
  id                  String   @id @default(uuid()) @db.UniqueIdentifier
  vehicleId           String   @db.UniqueIdentifier
  driverId            String?  @db.UniqueIdentifier
  tripId              String?  @db.UniqueIdentifier
  speed               Float
  latitude            Float
  longitude           Float
  recordedAt          DateTime @db.DateTime2
  source              String   @default("PHONE_GPS")
  effectiveSpeedLimit Float
  limitSource         String
  isOverspeeding      Boolean  @default(false)
  vehicle             Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver              Driver?  @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trip                Trip?    @relation(fields: [tripId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt           DateTime @default(now()) @db.DateTime2

  @@index([vehicleId, recordedAt])
  @@index([driverId, recordedAt])
  @@index([tripId, recordedAt])
  @@index([isOverspeeding, recordedAt])
  @@map("speed_readings")
}

model SpeedViolation {
  id                  String                @id @default(uuid()) @db.UniqueIdentifier
  vehicleId           String                @db.UniqueIdentifier
  driverId            String?               @db.UniqueIdentifier
  tripId              String?               @db.UniqueIdentifier
  vehicleTypeId       String?               @db.UniqueIdentifier
  recordedSpeed       Float
  maximumSpeed        Float
  effectiveSpeedLimit Float
  excessSpeed         Float
  severity            String
  latitude            Float
  longitude           Float
  locationName        String?               @db.NVarChar(500)
  startedAt           DateTime              @db.DateTime2
  lastSeenAt          DateTime              @db.DateTime2
  endedAt             DateTime?             @db.DateTime2
  durationSeconds     Int                   @default(0)
  status              String                @default("ACTIVE")
  acknowledgedAt      DateTime?             @db.DateTime2
  acknowledgedById    String?               @db.UniqueIdentifier
  resolutionNote      String?               @db.NVarChar(2000)
  lastAlertedAt       DateTime?             @db.DateTime2
  vehicle             Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver              Driver?               @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trip                Trip?                 @relation(fields: [tripId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleType         VehicleType?          @relation(fields: [vehicleTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  acknowledgedBy      User?                 @relation("SpeedViolationAcknowledger", fields: [acknowledgedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  audits              SpeedViolationAudit[]
  createdAt           DateTime              @default(now()) @db.DateTime2
  updatedAt           DateTime              @updatedAt @db.DateTime2

  @@index([status, startedAt])
  @@index([vehicleId, startedAt])
  @@index([driverId, startedAt])
  @@index([tripId, startedAt])
  @@index([severity, startedAt])
  @@map("speed_violations")
}

model SpeedViolationAudit {
  id          String         @id @default(uuid()) @db.UniqueIdentifier
  violationId String         @db.UniqueIdentifier
  actorId     String?        @db.UniqueIdentifier
  action      String
  fromStatus  String?
  toStatus    String?
  note        String?        @db.NVarChar(2000)
  violation   SpeedViolation @relation(fields: [violationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor       User?          @relation("SpeedViolationAuditActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime       @default(now()) @db.DateTime2

  @@index([violationId, createdAt])
  @@index([actorId, createdAt])
  @@map("speed_violation_audits")
}

model FuelVendor {
  id        String        @id @default(uuid()) @db.UniqueIdentifier
  name      String        @unique
  contact   String?
  email     String?
  phone     String?
  status    String        @default("ACTIVE")
  notes     String?       @db.NVarChar(2000)
  stations  FuelStation[]
  entries   FuelEntry[]
  prices    FuelPrice[]
  createdAt DateTime      @default(now()) @db.DateTime2
  updatedAt DateTime      @updatedAt @db.DateTime2

  @@index([status, name])
  @@map("fuel_vendors")
}

model FuelStation {
  id        String      @id @default(uuid()) @db.UniqueIdentifier
  vendorId  String?     @db.UniqueIdentifier
  name      String
  brand     String?
  address   String?     @db.NVarChar(1000)
  state     String
  city      String?
  latitude  Decimal?    @db.Decimal(10, 7)
  longitude Decimal?    @db.Decimal(10, 7)
  contact   String?
  status    String      @default("ACTIVE")
  vendor    FuelVendor? @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prices    FuelPrice[]
  entries   FuelEntry[]
  cards     FuelCard[]  @relation("FuelCardStation")
  createdAt DateTime    @default(now()) @db.DateTime2
  updatedAt DateTime    @updatedAt @db.DateTime2

  @@unique([name, state, city])
  @@index([status, state, city])
  @@index([vendorId])
  @@map("fuel_stations")
}

model FuelPrice {
  id            String       @id @default(uuid()) @db.UniqueIdentifier
  stationId     String?      @db.UniqueIdentifier
  vendorId      String?      @db.UniqueIdentifier
  state         String
  fuelType      String
  effectiveDate DateTime     @db.Date
  pricePerLitre Decimal      @db.Decimal(18, 2)
  tolerancePct  Decimal      @default(10) @db.Decimal(6, 2)
  status        String       @default("ACTIVE")
  station       FuelStation? @relation(fields: [stationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor        FuelVendor?  @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime     @default(now()) @db.DateTime2
  updatedAt     DateTime     @updatedAt @db.DateTime2

  @@index([state, fuelType, effectiveDate])
  @@index([stationId, effectiveDate])
  @@map("fuel_prices")
}

model FuelCard {
  id               String                @id @default(uuid()) @db.UniqueIdentifier
  cardNumber       String                @unique
  maskedNumber     String
  provider         String
  encryptedPin     String?               @db.NVarChar(2000)
  status           String                @default("ACTIVE")
  issueDate        DateTime              @db.Date
  expiryDate       DateTime?             @db.Date
  vehicleId        String?               @db.UniqueIdentifier
  driverId         String?               @db.UniqueIdentifier
  officeId         String?               @db.UniqueIdentifier
  monthlyLimit     Decimal?              @db.Decimal(18, 2)
  dailyLimit       Decimal?              @db.Decimal(18, 2)
  transactionLimit Decimal?              @db.Decimal(18, 2)
  currentBalance   Decimal?              @db.Decimal(18, 2)
  allowedFuelTypes String?               @db.NVarChar(1000)
  allowedStates    String?               @db.NVarChar(1000)
  allowedStationId String?               @db.UniqueIdentifier
  notes            String?               @db.NVarChar(2000)
  vehicle          Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver           Driver?               @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  office           Location?             @relation(fields: [officeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  allowedStation   FuelStation?          @relation("FuelCardStation", fields: [allowedStationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entries          FuelEntry[]
  transactions     FuelCardTransaction[]
  createdAt        DateTime              @default(now()) @db.DateTime2
  updatedAt        DateTime              @updatedAt @db.DateTime2

  @@index([status, expiryDate])
  @@index([vehicleId])
  @@index([driverId])
  @@map("fuel_cards")
}

model FuelCardTransaction {
  id                String     @id @default(uuid()) @db.UniqueIdentifier
  fuelCardId        String     @db.UniqueIdentifier
  fuelEntryId       String?    @unique @db.UniqueIdentifier
  transactionNumber String     @unique
  amount            Decimal    @db.Decimal(18, 2)
  transactionAt     DateTime   @db.DateTime2
  status            String     @default("PENDING")
  reconciliationRef String?
  notes             String?    @db.NVarChar(2000)
  card              FuelCard   @relation(fields: [fuelCardId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fuelEntry         FuelEntry? @relation(fields: [fuelEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt         DateTime   @default(now()) @db.DateTime2
  updatedAt         DateTime   @updatedAt @db.DateTime2

  @@index([fuelCardId, transactionAt])
  @@map("fuel_card_transactions")
}

model VehicleFuelBaseline {
  id                     String   @id @default(uuid()) @db.UniqueIdentifier
  vehicleId              String   @unique @db.UniqueIdentifier
  expectedKmPerLitre     Decimal? @db.Decimal(12, 3)
  manufacturerKmPerLitre Decimal? @db.Decimal(12, 3)
  tankCapacityLitres     Decimal? @db.Decimal(12, 3)
  acceptableTolerancePct Decimal  @default(10) @db.Decimal(6, 2)
  vehicle                Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt              DateTime @default(now()) @db.DateTime2
  updatedAt              DateTime @updatedAt @db.DateTime2

  @@map("vehicle_fuel_baselines")
}

model FuelBudget {
  id            String       @id @default(uuid()) @db.UniqueIdentifier
  name          String
  fiscalYear    Int
  month         Int?
  amount        Decimal      @db.Decimal(18, 2)
  committed     Decimal      @default(0) @db.Decimal(18, 2)
  spent         Decimal      @default(0) @db.Decimal(18, 2)
  directorateId String?      @db.UniqueIdentifier
  departmentId  String?      @db.UniqueIdentifier
  officeId      String?      @db.UniqueIdentifier
  status        String       @default("ACTIVE")
  directorate   Directorate? @relation(fields: [directorateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  office        Location?    @relation(fields: [officeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime     @default(now()) @db.DateTime2
  updatedAt     DateTime     @updatedAt @db.DateTime2

  @@index([fiscalYear, month, status])
  @@index([departmentId])
  @@map("fuel_budgets")
}

model FuelEntry {
  id                    String               @id @default(uuid()) @db.UniqueIdentifier
  entryNumber           String               @unique
  vehicleId             String               @db.UniqueIdentifier
  driverId              String               @db.UniqueIdentifier
  allocationId          String?              @db.UniqueIdentifier
  tripId                String?              @db.UniqueIdentifier
  createdById           String               @db.UniqueIdentifier
  fuelCardId            String?              @db.UniqueIdentifier
  stationId             String?              @db.UniqueIdentifier
  vendorId              String?              @db.UniqueIdentifier
  fuelingAt             DateTime             @db.DateTime2
  entryType             String               @default("REFUEL")
  fuelType              String
  entryStatus           String               @default("DRAFT")
  approvalStatus        String               @default("DRAFT")
  reason                String?              @db.NVarChar(1000)
  comments              String?              @db.NVarChar(2000)
  vehicleRegistration   String
  driverName            String
  driverEmployeeId      String
  allocationSnapshot    String?              @db.NVarChar(100)
  tripSnapshot          String?              @db.NVarChar(100)
  departmentName        String?
  directorateName       String?
  officeName            String?
  unitName              String?
  supervisorName        String?
  state                 String?
  city                  String?
  stationName           String?
  stationLocation       String?
  pumpNumber            String?
  fuelLevelBefore       Decimal?             @db.Decimal(6, 2)
  fuelLevelAfter        Decimal?             @db.Decimal(6, 2)
  requestedLitres       Decimal?             @db.Decimal(18, 3)
  dispensedLitres       Decimal              @db.Decimal(18, 3)
  approvedPricePerLitre Decimal?             @db.Decimal(18, 2)
  pricePerLitre         Decimal              @db.Decimal(18, 2)
  totalAmount           Decimal              @db.Decimal(18, 2)
  paymentMethod         String
  cardTransactionNumber String?
  receiptNumber         String?
  vendorInvoice         String?
  previousOdometer      Decimal?             @db.Decimal(18, 2)
  currentOdometer       Decimal?             @db.Decimal(18, 2)
  distanceTravelled     Decimal?             @db.Decimal(18, 2)
  gpsDistance           Decimal?             @db.Decimal(18, 2)
  tripDistance          Decimal?             @db.Decimal(18, 2)
  engineHours           Decimal?             @db.Decimal(18, 2)
  distanceSource        String?
  kmPerLitre            Decimal?             @db.Decimal(18, 4)
  litresPer100Km        Decimal?             @db.Decimal(18, 4)
  costPerKm             Decimal?             @db.Decimal(18, 4)
  baselineDifference    Decimal?             @db.Decimal(18, 4)
  baselineVariancePct   Decimal?             @db.Decimal(8, 2)
  latitude              Decimal?             @db.Decimal(10, 7)
  longitude             Decimal?             @db.Decimal(10, 7)
  submittedAt           DateTime?            @db.DateTime2
  approvedAt            DateTime?            @db.DateTime2
  postedAt              DateTime?            @db.DateTime2
  vehicle               Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver                Driver               @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  allocation            VehicleAllocation?   @relation(fields: [allocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trip                  Trip?                @relation(fields: [tripId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy             User                 @relation("FuelEntryCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fuelCard              FuelCard?            @relation(fields: [fuelCardId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  station               FuelStation?         @relation(fields: [stationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor                FuelVendor?          @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachments           FuelAttachment[]
  approvals             FuelApproval[]
  alerts                FuelAlert[]
  reconciliation        FuelReconciliation?
  auditLogs             FuelAuditLog[]
  cardTransaction       FuelCardTransaction?
  createdAt             DateTime             @default(now()) @db.DateTime2
  updatedAt             DateTime             @updatedAt @db.DateTime2

  @@index([vehicleId, fuelingAt])
  @@index([driverId, fuelingAt])
  @@index([allocationId, fuelingAt])
  @@index([tripId])
  @@index([approvalStatus, fuelingAt])
  @@index([receiptNumber])
  @@map("fuel_entries")
}

model FuelApproval {
  id          String    @id @default(uuid()) @db.UniqueIdentifier
  fuelEntryId String    @db.UniqueIdentifier
  actorId     String?   @db.UniqueIdentifier
  stage       String
  status      String    @default("PENDING")
  comment     String?   @db.NVarChar(2000)
  actedAt     DateTime? @db.DateTime2
  fuelEntry   FuelEntry @relation(fields: [fuelEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor       User?     @relation("FuelApprovalActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime  @default(now()) @db.DateTime2

  @@index([fuelEntryId, stage])
  @@index([status, stage])
  @@map("fuel_approvals")
}

model FuelAttachment {
  id          String    @id @default(uuid()) @db.UniqueIdentifier
  fuelEntryId String    @db.UniqueIdentifier
  kind        String
  fileName    String
  mimeType    String
  sizeBytes   Int
  data        Bytes
  fuelEntry   FuelEntry @relation(fields: [fuelEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime  @default(now()) @db.DateTime2

  @@index([fuelEntryId, kind])
  @@map("fuel_attachments")
}

model FuelAlert {
  id          String     @id @default(uuid()) @db.UniqueIdentifier
  fuelEntryId String?    @db.UniqueIdentifier
  alertType   String
  severity    String     @default("WARNING")
  message     String     @db.NVarChar(2000)
  status      String     @default("OPEN")
  resolvedAt  DateTime?  @db.DateTime2
  fuelEntry   FuelEntry? @relation(fields: [fuelEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime   @default(now()) @db.DateTime2

  @@index([status, severity, createdAt])
  @@index([fuelEntryId])
  @@map("fuel_alerts")
}

model FuelReconciliation {
  id               String    @id @default(uuid()) @db.UniqueIdentifier
  fuelEntryId      String    @unique @db.UniqueIdentifier
  reconciledAmount Decimal?  @db.Decimal(18, 2)
  varianceAmount   Decimal?  @db.Decimal(18, 2)
  status           String    @default("PENDING")
  notes            String?   @db.NVarChar(2000)
  reconciledAt     DateTime? @db.DateTime2
  fuelEntry        FuelEntry @relation(fields: [fuelEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt        DateTime  @default(now()) @db.DateTime2
  updatedAt        DateTime  @updatedAt @db.DateTime2

  @@index([status, createdAt])
  @@map("fuel_reconciliations")
}

model FuelAuditLog {
  id          String     @id @default(uuid()) @db.UniqueIdentifier
  fuelEntryId String?    @db.UniqueIdentifier
  actorId     String?    @db.UniqueIdentifier
  action      String
  entityType  String
  entityId    String
  details     String?    @db.NVarChar(4000)
  fuelEntry   FuelEntry? @relation(fields: [fuelEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor       User?      @relation("FuelAuditActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime   @default(now()) @db.DateTime2

  @@index([entityType, entityId, createdAt])
  @@index([fuelEntryId])
  @@map("fuel_audit_logs")
}
